# Set default behavior to automatic text conversion with LF line endings.
* text=auto eol=lf

# Force Android source files, XML, Gradle scripts and docs to use LF line endings
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
gradlew text eol=lf

# Keep binary assets untouched
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jar binary
*.aar binary
