# EditorConfig help the developers define and maintain consistent coding styles between different editors and IDEs.
# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4

[*.gradle]
indent_style = space
indent_size = 4
